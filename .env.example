# LLM Provider Configuration
# Set at least ONE of the following API keys based on your preferred provider:

# Option 1: OpenAI (Default)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Option 2: Google Gemini
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Option 3: Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Option 4: Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Active LLM Provider: "auto", "openai", "gemini", "anthropic", "groq", or "mock"
# "auto" will select the first provider with an active API key, or fallback to mock mode if none is provided.
LLM_PROVIDER=auto

# Application Settings
SOP_FILE_PATH=data/sops.yaml
OPEN_METEO_TIMEOUT_SECONDS=10
