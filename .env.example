# ==============================================================================
# LLM Provider Configuration
# Set ONLY the key for the provider you want to use (leave others blank or omitted)
# If no key is provided, the bot runs in deterministic offline mode (0 keys required).
# ==============================================================================

# Option A: Google Gemini
GOOGLE_API_KEY=your_gemini_api_key_here

# Option B: Groq (For open-source Llama 3 models)
GROQ_API_KEY=your_groq_api_key_here

# Option C: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
